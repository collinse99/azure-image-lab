{
  "variables": {
    "location": "eastus",
    "vm_size": "Standard_B2s",
    "image_name": "rhel8-golden-lab",
    "image_resource_group": "rg-image-lab",
    "image_publisher": "RedHat",
    "image_offer": "RHEL",
    "image_sku": "810-gen2",
    "image_version": "8.10.2026102317"
  },

  "builders": [
    {
      "type": "azure-arm",
      "use_azure_cli_auth": true,
      "os_type": "Linux",

      "build_resource_group_name": "rg-image-build",
      "vm_size": "{{user `vm_size`}}",

      "image_publisher": "{{user `image_publisher`}}",
      "image_offer": "{{user `image_offer`}}",
      "image_sku": "{{user `image_sku`}}",
      "image_version": "{{user `image_version`}}",

      "managed_image_name": "{{user `image_name`}}",
      "managed_image_resource_group_name": "{{user `image_resource_group`}}"
    }
  ],

"provisioners": [
  {
    "type": "ansible",
    "playbook_file": "./ansible/baseline.yml"
  },
  {
    "type": "shell",
    "inline": [
      "sudo /usr/sbin/waagent -deprovision+user -force",
      "export HISTSIZE=0",
      "sync"
    ],
    "inline_shebang": "/bin/sh -e"
  }
]
}
